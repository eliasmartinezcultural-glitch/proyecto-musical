{
  "manifest_version": 3,
  "name": "Ocarina · Transpositor de Sala",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "Cambia el tono del audio de la Sala de Ensayo en tiempo real con procesamiento local WASM.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://eliasmartinezcultural-glitch.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Activar o detener el transpositor Ocarina"
  },
  "content_scripts": [
    {
      "matches": [
        "https://eliasmartinezcultural-glitch.github.io/proyecto-musical/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}