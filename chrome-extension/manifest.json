{
  "manifest_version": 3,
  "name": "Ocarina · Transpositor de Sala",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Transpone el audio de YouTube que suena dentro de la Sala de Ensayo.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://eliasmartinezcultural-glitch.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Activar o detener el transpositor Ocarina"
  },
  "content_scripts": [
    {
      "matches": [
        "https://eliasmartinezcultural-glitch.github.io/proyecto-musical/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}